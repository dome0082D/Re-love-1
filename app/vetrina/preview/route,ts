// app/api/vetrina/preview/route.ts
// Riceve un link esterno (Amazon, eBay, un qualsiasi sito) e prova a
// leggerne titolo e immagine reali, leggendo i tag "og:title"/"og:image"
// della pagina - la stessa tecnica che usano WhatsApp o Telegram per
// mostrare l'anteprima quando incolli un link.
//
// Amazon (e altri siti) spesso rifiutano o mostrano una pagina "vuota"
// anti-bot se la richiesta non sembra fatta da un vero browser: per questo
// mandiamo uno User-Agent realistico, non quello di default di Node.

import { NextRequest, NextResponse } from 'next/server'

export const dynamic = 'force-dynamic'

const USER_AGENT =
  'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ' +
  '(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36'

function estraiMetaTag(html: string, proprieta: string): string | null {
  // Cerca sia <meta property="og:xxx" content="..."> che l'ordine
  // invertito <meta content="..." property="og:xxx">, perché i siti non
  // sono tutti coerenti nell'ordine degli attributi.
  const pattern1 = new RegExp(
    `<meta[^>]+property=["']${proprieta}["'][^>]+content=["']([^"']+)["']`,
    'i'
  )
  const pattern2 = new RegExp(
    `<meta[^>]+content=["']([^"']+)["'][^>]+property=["']${proprieta}["']`,
    'i'
  )
  const match = html.match(pattern1) || html.match(pattern2)
  return match ? match[1] : null
}

function estraiTitoloFallback(html: string): string | null {
  const match = html.match(/<title[^>]*>([^<]+)<\/title>/i)
  return match ? match[1].trim() : null
}

export async function POST(req: NextRequest) {
  try {
    const { url } = await req.json()

    if (!url || typeof url !== 'string') {
      return NextResponse.json({ error: 'Indirizzo mancante.' }, { status: 400 })
    }

    let parsedUrl: URL
    try {
      parsedUrl = new URL(url)
      if (parsedUrl.protocol !== 'http:' && parsedUrl.protocol !== 'https:') {
        throw new Error('protocollo non valido')
      }
    } catch {
      return NextResponse.json({ error: 'Indirizzo non valido.' }, { status: 400 })
    }

    const res = await fetch(parsedUrl.toString(), {
      headers: {
        'User-Agent': USER_AGENT,
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        'Accept-Language': 'it-IT,it;q=0.9,en;q=0.8',
      },
      // Non seguiamo all'infinito redirect strani, ma seguiamo quelli
      // normali (es. link accorciati amzn.to che rimandano alla pagina
      // vera del prodotto).
      redirect: 'follow',
    })

    if (!res.ok) {
      console.error('[Vetrina/Preview] Risposta non ok:', res.status, parsedUrl.toString())
      return NextResponse.json(
        { error: "Impossibile raggiungere quell'indirizzo." },
        { status: 502 }
      )
    }

    const html = await res.text()

    const title = estraiMetaTag(html, 'og:title') || estraiTitoloFallback(html)
    let image = estraiMetaTag(html, 'og:image')

    // Alcuni siti (Amazon incluso, a volte) restituiscono un'immagine con
    // indirizzo relativo invece che completo - la completiamo noi.
    if (image && !image.startsWith('http')) {
      try {
        image = new URL(image, parsedUrl.origin).toString()
      } catch {
        image = null
      }
    }

    if (!title && !image) {
      return NextResponse.json(
        { error: "Non è stato possibile leggere un'anteprima da questo link. Compila titolo e immagine a mano." },
        { status: 200 }
      )
    }

    return NextResponse.json({ title, image })
  } catch (err) {
    console.error('[Vetrina/Preview] Errore:', err)
    return NextResponse.json(
      { error: "Errore durante il recupero dell'anteprima." },
      { status: 500 }
    )
  }
}